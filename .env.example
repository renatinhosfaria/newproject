# Variáveis lidas somente pelo Compose (infra/compose/compose.yaml).
# Descrição completa e demais variáveis (DATABASE_URL, NODE_ENV, API_HOST,
# API_PORT, DB_POOL_MAX, testes e E2E): seção "Variáveis de ambiente" do README.
# Porta publicada pelo proxy em 127.0.0.1; APP_ORIGIN precisa usar a mesma porta.
APP_PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
# Senhas das roles owner e app. Use valores hex seguros para URL: openssl rand -hex 32
# O PostgreSQL só as aplica ao criar o volume pgdata.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Usuários locais do seed: e-mails sintéticos e senhas geradas com openssl rand -hex 32
SEED_SUPERVISOR_EMAIL=
SEED_SUPERVISOR_PASSWORD=
SEED_BROKER_EMAIL=
SEED_BROKER_PASSWORD=
