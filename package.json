{
  "name": "pacaembu-crm",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.27.1 <12"
  },
  "scripts": {
    "test": "node scripts/run-test-suite.mjs",
    "test:contract": "vitest run tests/contracts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e:compose": "playwright test --config playwright.compose.config.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @pacaembu/web typecheck",
    "lint": "eslint packages tests apps/api apps/web vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check packages scripts tests db apps infra .prettierrc.json package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json vitest.config.ts playwright.config.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:maintenance": "tsx db/maintenance.ts",
    "build": "pnpm --filter @pacaembu/web build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@typescript-eslint/parser": "8.70.1",
    "argon2": "0.44.0",
    "drizzle-orm": "0.44.5",
    "eslint": "9.39.5",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "prettier": "3.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.0.14",
    "yaml": "2.9.1",
    "zod": "3.25.76",
    "@playwright/test": "1.63.0",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
